# Supabase (already in use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://www.arwignplanners.com

# Stripe (already in use)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- NEW: Pillar 1 additions ---

# Resend (email provider)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Sender address(es) — must be on a domain verified in Resend.
# Simplest setup: set FROM_EMAIL and leave the per-category vars blank; all mail
# falls back to it. Set the per-category vars only to use different from-addresses
# for info / sales / support mail.
FROM_EMAIL=Arwign Planners <hello@arwignplanners.com>
EMAIL_FROM_INFO=
EMAIL_FROM_SALES=
EMAIL_FROM_SUPPORT=
# Resend → Webhooks → "Signing Secret" (starts with whsec_). Required for
# bounce / complaint / unsubscribe tracking at /api/webhooks/email.
EMAIL_WEBHOOK_SECRET=

# Nurture cron protection (also protects the hourly daily-briefing cron)
# Generate: openssl rand -hex 32
CRON_SECRET=

# Twilio — SMS Daily Outlook Briefing (Arwign Calendar Plus)
# From the Twilio console. Provide a Messaging Service (preferred) OR a From number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Receives admin notifications (e.g. new personalized notebook requests)
ADMIN_EMAIL=admin@arwignplanners.com

# PayPal (checkout buttons + server capture)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# Paystack (card & mobile money checkout — charges in USD)
# From your Paystack dashboard → Settings → API Keys & Webhooks.
# Use pk_test_/sk_test_ while testing, then pk_live_/sk_live_ when live.
# NOTE: charging in USD requires USD to be enabled on your Paystack account.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# PesaPal (Visa / Mastercard checkout)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# sandbox (cybqa.pesapal.com) | live (pay.pesapal.com)
PESAPAL_ENV=live
# Optional — pin a previously-registered IPN id to skip re-registering on every cold start
PESAPAL_IPN_ID=

# Google Analytics 4 measurement id
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) ads — both from Meta Events Manager.
# Pixel id (numeric): Events Manager -> Data sources -> your pixel -> Settings.
NEXT_PUBLIC_FB_PIXEL_ID=
# Conversions API token: same Settings page -> "Conversions API" -> Generate access token.
# Enables server-side Purchase events (deduped with the browser pixel).
META_CAPI_ACCESS_TOKEN=
